<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.7</version>
        <relativePath/>
    </parent>

    <groupId>net.innoventa</groupId>
    <artifactId>tessera-api</artifactId>
    <version>0.1.0</version>
    <name>Tessera API</name>
    <description>Jira-style project and issue tracker for the Innoventa workspace — resource server, authenticated by Identity, localized through Central</description>

    <properties>
        <java.version>21</java.version>
        <lombok.version>1.18.32</lombok.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok.mapstruct.binding.version>0.2.0</lombok.mapstruct.binding.version>
        <springdoc.version>2.5.0</springdoc.version>
        <testcontainers.version>1.19.8</testcontainers.version>
        <!-- ⚠️ Held at the same version as everything else jMouse, and it has to be. `jmouse-access-el`
             parses the policy document with `jmouse-el`'s parser and is built against this build of it;
             pinned back to Stable_20260728 it loaded, started, and died on the first policy read with
             NoClassDefFoundError: org/jmouse/el/parser/AutodetectFirstParser — from inside an
             auto-configuration, naming a bean nobody wrote. -->
        <jmouse.el.version>${jmouse.version}</jmouse.el.version>
        <jmouse.version>1.0.0-b20260802</jmouse.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <!-- Web / Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Security — resource server only; Tessera never mints tokens, it validates the ones
             issued by the Identity service (see config/SecurityConfiguration). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- Data / JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- ⚠️ Boot 4 splits autoconfiguration into per-technology modules, and Flyway is the one
             dependency here taken without a Boot starter — so THIS module is what actually runs the
             migrations. Without it `flyway-core` sits on the classpath doing nothing: no log line, no
             error, migrations silently never applied. An already-migrated database starts perfectly
             well and only surfaces the gap whenever the next migration is added.

             That silence is why it is named before flyway-core rather than after it. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Database drivers — MySQL is the default, PostgreSQL the opt-in `postgresql` profile. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- OpenAPI -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Boilerplate reduction -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- Entity <-> DTO mapping — records as DTOs, same convention as Innoventa/BE and Moneta/BE.
             Used for the flat configuration-catalog responses; the richer, nested project/member
             responses are hand-built in their services (mirroring Moneta's Budget/Goal/Debt). -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>

        <!-- jMouse Expression Language — the board's filter engine (ADR-0008). Tessera does not invent
             a query language; a filter is a jME boolean predicate evaluated over the loaded board
             slice. Pulls jmouse-core transitively. -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-el</artifactId>
            <version>${jmouse.el.version}</version>
        </dependency>

        <!-- Authorization. Tessera's own model — a role per project plus per-member ALLOW/DENY
             overrides — becomes grants the engine reads (`TesseraGrantStore`); the tables do not
             change. What arrives is the five ordered axes, the covering chain, deny-wins with the
             subtraction last, and a policy document that fails the boot on a permission nobody
             declared.

             ⚠️ The permission half only. The axes are independent, and a product with no
             CapabilityCatalog has no entitlement axis and nothing refusing with 402. Tessera sells
             nothing yet; capabilities wait until it does. -->
        <!-- jMQ — the shared filter builder. ⚠️ Beside the jME board filter, not instead of it: that one
             marks loaded cards over a rich object graph and stays. This one answers WHICH issues, in SQL,
             so paging and counts are real. Tessera contributes a QuerySubject and a schema; the composer,
             the decomposer and the two addresses are the library's and are identical in every product. -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-query-spring-boot</artifactId>
            <version>${jmouse.version}</version>
        </dependency>

        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-access</artifactId>
            <version>${jmouse.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-access-enforcement</artifactId>
            <version>${jmouse.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-access-spring-boot</artifactId>
            <version>${jmouse.version}</version>
        </dependency>
        <!-- The engine's own schema and stores. ⚠️ jmouse-access-jpa OWNS every access_* table,
             mapping included, and migrates them against a history table of its own — so Tessera
             writes no @Entity over one and adds `org.jmouse.access.jpa.entity` to its @EntityScan.
             Forgetting that line starts cleanly and dies on the first query, because Hibernate
             validates only what it was given. -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-access-jpa</artifactId>
            <version>${jmouse.version}</version>
        </dependency>
        <!-- The policy document. ⚠️ It is the SEED and the projection, never a second grant store:
             what the engine reads is a row, and `policy/tessera.jmp` is what a fresh installation is
             born with. jmouse-access-el is the grammar, jmouse-access-policy the model it binds to;
             the auto-configuration only wakes up when both are on the classpath. -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-access-policy</artifactId>
            <version>${jmouse.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-access-el</artifactId>
            <version>${jmouse.version}</version>
        </dependency>

        <!-- The tables read back out as the document that describes them: the access screen's
             "what is actually in force" pane. ⚠️ Its own module because the three it needs must not
             depend on each other — see jmouse-access-projection's pom. -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-access-projection</artifactId>
            <version>${jmouse.version}</version>
        </dependency>

        <!-- Bytes. Tessera stores exactly one kind of file today — a member's avatar — and stores it
             through the same library Innoventa and Moneta use rather than writing a third answer to
             "where did that upload go". What arrives is the whole mechanism: the acceptance policy,
             the key layout, the digest and its deduplication, the registry row, and a delivery
             planner that decides between streaming and a presigned redirect.

             ⚠️ jmouse-storage-jpa OWNS `stored_files`, mapping and migrations included, against a
             history table of its own — exactly like jmouse-access-jpa owns the access_* tables. So
             Tessera writes no @Entity over it and adds `org.jmouse.storage.jpa` to its @EntityScan.
             Its Flyway run is ordered BEFORE the product's by the library itself, which is what lets
             V000018 declare a foreign key into a table Tessera never created.

             ⚠️ S3 is on the classpath but unused: `tessera.file.provider` is `local`, and the whole
             point of carrying the module anyway is that moving avatars to MinIO later is a change to
             the yaml and to nothing else. -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-storage-spring-boot</artifactId>
            <version>${jmouse.version}</version>
        </dependency>

        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-avatars</artifactId>
            <version>${jmouse.version}</version>
        </dependency>

        <!-- Files: the row, the polymorphic binding, and — unusually — the ENDPOINTS too.

             ⚠️ Tessera is the one product that takes the library's routes rather than writing its own,
             because it has no file routes of its own to keep: an attachment hangs off an issue and
             needs no public byte route, no tree-wide search and no share token. Where Kiwi and
             Innoventa each have product-specific file surfaces, this has none, so the library's is
             exactly right. -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-storage-management</artifactId>
            <version>${jmouse.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-storage-jpa</artifactId>
            <version>${jmouse.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-storage-s3</artifactId>
            <version>${jmouse.version}</version>
        </dependency>

        <!-- The tool mechanism. Tessera contributed nothing to its design, which is the point: if a
             tracker can get tools and an assistant from a handful of ToolDefinition beans, the
             abstraction is real, and anything that has to change in the library is the most valuable
             finding of the whole effort.

             ⚠️ No starter. There is none for Boot 3 and deliberately will not be one — the beans are
             declared by hand in `config/AiConfiguration`, copied from Central's, which is the worked
             example that arrangement promises. Every module here is plain Java: `jmouse-ai` asks for
             no Spring, no JPA and no protocol SDK, and `jmouse-ai-provider` speaks
             java.net.http.HttpClient rather than anything of Spring's. -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-ai</artifactId>
            <version>${jmouse.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-ai-provider</artifactId>
            <version>${jmouse.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-ai-conversation</artifactId>
            <version>${jmouse.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-ai-jpa</artifactId>
            <version>${jmouse.version}</version>
        </dependency>
        <!-- The starter, which this product spent four hundred lines of `AiConfiguration` doing by
             hand on the strength of a comment saying there was no starter on Spring Boot 3. That was
             copied from the product that really is on Boot 3; this one has been on Boot 4 for some
             time, and the other Boot 4 product has taken this module all along.

             Everything it contributes is @ConditionalOnMissingBean, so the two beans that remain in
             `AiConfiguration` still win, and the @Components that decide something — the caller
             resolver, the authorizer, the scope resolver — it steps aside for without either side
             naming the other. -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-ai-spring-boot</artifactId>
            <version>${jmouse.version}</version>
        </dependency>
        <!-- The bridge between a tool caller and the access engine. Taken for `CallerSubjects` alone:
             a caller acting on behalf of somebody IS the engine's service sub-account, and that one
             translation has to be identical wherever it is made. Tessera's own ToolAuthorizer omitted
             it and quietly authorized a restricted agent as its owner.

             ⚠️ Its AccessToolAuthorizer is NOT in use yet — it needs a ScopeCatalog this product has
             not published — so `TesseraToolAuthorizer` stays the bean and borrows the translation. -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-ai-access</artifactId>
            <version>${jmouse.version}</version>
        </dependency>
        <!-- The management screens' server half — the catalogue, the trail, the counters, what is in
             force, and the one thing that writes: the provider configuration.

             ⚠️ NOTHING IN IT IS GUARDED. A library's handler cannot carry @RequiresAccess, so Tessera
             states the rule ABOUT those types instead — see `AiManagementAccess`, whose ExternalAccessRules
             bean gates them on `ai:read` / `ai:administer` at GLOBAL through the same engine as every
             route Tessera wrote itself. The alternative, a URL rule keyed on a role, reaches none of the
             axes and is the arrangement that made Innoventa write its own copy of this module. -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-ai-management</artifactId>
            <version>${jmouse.version}</version>
        </dependency>

        <!-- The catalogue, published over the Model Context Protocol. ⚠️ It decides nothing: every
             handler it exposes goes through the same ToolDispatcher the in-app assistant calls, so
             there is no second path into an action and no second place a permission is checked.

             It brings the MCP Java SDK, whose `HttpServletStreamableServerTransportProvider` is a plain
             HttpServlet — so no Spring MCP module is needed here: the servlet is registered by hand and
             Spring Security's filter chain authenticates in front of it.

             ⚠️ It is also what forced the move to Boot 4. The SDK's only JSON binding is Jackson 3, and
             Jackson 3 kept its annotations in Jackson 2's package — so on Boot 3.3.2 the server refused
             to build with NoSuchFieldError on JsonFormat$Shape.POJO. See McpConfiguration. -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-ai-mcp</artifactId>
            <version>${jmouse.version}</version>
        </dependency>

        <!-- The three protocol endpoints and the consent screen, which used to be written out here.
             ⚠️ Its endpoints appear only because Tessera declares a CredentialIssuer bean — the module
             will not map three public routes on somebody who has not said what minting means. What is
             NOT in it, and stays here, is everything about a credential: McpCredentialService's HS256
             signing, the cid claim, mcp_credentials and revocation. See TesseraCredentialIssuer. -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-ai-mcp-authorization</artifactId>
            <version>${jmouse.version}</version>
        </dependency>

        <!-- POST /api/blocks/resolve — the one address a product serves so ANOTHER product's document can
             quote its rows. ⚠️ The route, the wire contract and the dispatcher are the library's; Tessera
             contributes resolvers and nothing else, which is the point: WiQ's pages, Innoventa's pages and
             whatever comes next all call the same path, and nobody writes a fourth controller. ⚠️ It stays
             inert until `jmouse.liveblocks.enabled` is true — a library must not publish an endpoint on the
             strength of a jar being present. -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-liveblocks</artifactId>
            <version>${jmouse.version}</version>
        </dependency>

        <!-- The build rule. ⚠️ A handler under /api carrying neither @RequiresAccess nor
             @PublicEndpoint fails the build — which is the only thing that makes "authorization is
             declared where the route is served" true tomorrow as well as today. -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.3.0</version>
            <scope>test</scope>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>build-info</id>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                        <configuration>
                            <additionalProperties>
                                <java.version>${java.version}</java.version>
                            </additionalProperties>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <plugin>
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>get-git-info</id>
                        <goals><goal>revision</goal></goals>
                        <phase>initialize</phase>
                    </execution>
                </executions>
                <configuration>
                    <generateGitPropertiesFile>true</generateGitPropertiesFile>
                    <generateGitPropertiesFilename>${project.build.outputDirectory}/git.properties</generateGitPropertiesFilename>
                    <commitIdGenerationMode>full</commitIdGenerationMode>
                    <failOnNoGitDirectory>false</failOnNoGitDirectory>
                    <failOnUnableToExtractRepoInfo>false</failOnUnableToExtractRepoInfo>
                    <includeOnlyProperties>
                        <includeOnlyProperty>git.branch</includeOnlyProperty>
                        <includeOnlyProperty>git.commit.id.abbrev</includeOnlyProperty>
                        <includeOnlyProperty>git.commit.id</includeOnlyProperty>
                        <includeOnlyProperty>git.commit.time</includeOnlyProperty>
                        <includeOnlyProperty>git.commit.message.short</includeOnlyProperty>
                        <includeOnlyProperty>git.dirty</includeOnlyProperty>
                    </includeOnlyProperties>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>${lombok.mapstruct.binding.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
